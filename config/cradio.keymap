#define ZMK_MOUSE_DEFAULT_MOVE_VAL 2500  // 600
#define ZMK_MOUSE_DEFAULT_SCRL_VAL 20    // 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define MAC 0
#define WIN 1
#define RIG 2
#define LEF 3
#define TRI 4
#define MOUSE 5
#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT
#define U_WH_U &msc SCRL_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT

&sk { quick-release; };

&lt {
    retro-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <220>;
};

&mt {
    tapping-term-ms = <220>;
    flavor = "tap-preferred";
    retro-tap;
};

/ {
    chosen { zmk,charmap = &charmap_us; };

    behaviors {
        mmv {
            acceleration-exponent = <1>;      // 1
            time-to-max-speed-ms = <300>;    // 40
            delay-ms = <0>;                   // 0
        };

        msc {
            acceleration-exponent = <0>;      // 0
            time-to-max-speed-ms = <40>;      // 500
            delay-ms = <0>;                   // 10
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q         &kp W        &kp E           &kp R           &kp T            &kp Y        &kp U           &kp I               &kp O             &kp P
&mt LSHIFT A  &lt 5 S      &lt 1 D         &lt 3 F         &kp G            &kp H        &lt 4 J         &lt 2 K             &lt 6 L           &mt LSHIFT SEMICOLON
&kp Z         &mt LCTRL X  &mt LEFT_ALT C  &mt LEFT_GUI V  &kp B            &kp N        &mt LEFT_GUI M  &mt LEFT_ALT COMMA  &mt LCTRL PERIOD  &kp SLASH
                                           &none           &kp BACKSPACE    &lt 7 SPACE  &none
            >;
        };

        Mouse {
            bindings = <
&trans  &trans    &trans  &trans    &trans    &trans          &mkp MB1           &mmv MOVE_Y(-200)  &mkp MB2          &trans
&trans  &mkp MB1  &none   &mkp MB2  &trans    &mmv MOVE_LEFT  &mmv MOVE_DOWN     &mmv MOVE_UP       &mmv MOVE_RIGHT   &trans
&trans  &trans    &trans  &trans    &trans    &trans          &mmv MOVE_X(-200)  &mmv MOVE_Y(200)   &mmv MOVE_X(200)  &trans
                          &trans    &trans    &trans          &trans
            >;

            label = "mouse";
        };

        NAV {
            bindings = <
&trans  &kp HOME        &kp UP    &kp PG_UP      &trans    &trans  &trans        &trans  &trans              &trans
&trans  &kp LEFT_ARROW  &kp DOWN  &kp RIGHT      &trans    &trans  &kp LEFT_GUI  &none   &mt LCTRL LEFT_ALT  &mt LA(LCTRL) LSHIFT
&trans  &kp END         &trans    &kp PAGE_DOWN  &trans    &trans  &trans        &trans  &trans              &trans
                                  &trans         &trans    &trans  &trans
            >;

            label = "nav";
        };

        RightSymbols {
            bindings = <
&trans         &trans        &trans        &trans  &trans    &trans         &kp LS(UNDER)  &kp LS(PIPE)  &kp SQT      &trans
&kp LS(CARET)  &kp LS(STAR)  &kp LS(AMPS)  &none   &trans    &kp LS(POUND)  &kp LS(TILDE)  &kp GRAVE     &kp LS(DQT)  &kp LS(DLLR)
&trans         &trans        &trans        &trans  &trans    &trans         &kp MINUS      &kp BSLH      &kp GRAVE    &trans
                                           &trans  &trans    &trans         &trans
            >;
        };

        LeftSymbols {
            bindings = <
&trans        &kp LS(COLON)  &kp LS(LT)    &kp LS(GT)    &kp SEMI      &trans  &trans  &trans     &trans        &trans
&kp LS(LBRC)  &kp LS(RBRC)   &kp LS(LPAR)  &kp LS(RPAR)  &kp LS(AT)    &trans  &none   &kp EQUAL  &kp LS(PLUS)  &kp LS(PRCNT)
&trans        &kp LS(EXCL)   &kp LBKT      &kp RBKT      &trans        &trans  &trans  &trans     &trans        &trans
                                           &trans        &trans        &trans  &trans
            >;
        };

        FunctionKeys {
            bindings = <
&trans  &trans  &trans          &trans  &trans    &trans  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &none   &mt LCTRL LALT  &trans  &trans    &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans  &trans          &trans  &trans    &trans  &kp F1  &kp F2  &kp F3  &kp F12
                                &trans  &trans    &trans  &trans
            >;
        };

        Numbers {
            bindings = <
&kp FSLH      &kp N7  &kp N8  &kp N9  &kp LS(PLUS)    &trans  &trans  &trans  &trans  &trans
&kp N0        &kp N1  &kp N2  &kp N3  &kp MINUS       &trans  &trans  &trans  &none   &trans
&kp LS(STAR)  &kp N4  &kp N5  &kp N6  &kp EQUAL       &trans  &trans  &trans  &trans  &trans
                              &trans  &trans          &trans  &trans
            >;
        };

        Always {
            bindings = <
&trans  &trans         &kp LS(COLON)  &kp ESC       &trans     &sl 9  &trans        &trans               &trans            &kp BSPC
&trans  &kp LS(PRCNT)  &kp FSLH       &kp ENTER     &trans     &to 1  &kp LEFT_GUI  &trans               &trans            &trans
&trans  &trans         &trans         &kp LS(EXCL)  &trans     &to 0  &trans        &mt RIGHT_ALT COMMA  &mt RCTRL PERIOD  &to 8
                                      &trans        &kp TAB    &none  &trans
            >;
        };

        setting_layer {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR  &trans  &trans  &trans  &trans
&out OUT_TOG  &trans        &trans        &trans        &bt BT_CLR      &trans      &trans  &trans  &trans  &to 0
&none         &trans        &trans        &trans        &to 0           &to 0       &trans  &trans  &trans  &trans
                                          &trans        &trans          &to 0       &trans
            >;

            label = "setting";
        };

        magic_layer {
            bindings = <
&none  &none  &none  &none  &none                       &none  &none  &none  &none  &default_report
&none  &none  &none  &none  &kp LG(LS(LC(NUMBER_4)))    &none  &none  &none  &none  &to 0
&none  &none  &none  &none  &kp LG(LS(NUMBER_4))        &to 0  &none  &none  &none  &none
                     &none  &none                       &none  &none
            >;

            label = "magic";
        };
    };
};
